# 국가법령정보 공동활용 Open API
LAW_OPEN_API_OC=
LAW_OPEN_API_BASE_URL=https://www.law.go.kr/DRF
COLLECTOR_STATE_DIR=.collector-state
COLLECTOR_REQUEST_TIMEOUT_SECONDS=30

# API runtime/provider settings belong in apps/api/.env.local. This root file
# only owns cross-package collector, embedding, database and web settings.

# Supabase / PostgreSQL (서버 전용)
APP_NAME=에너지 법령 RAG
ENVIRONMENT=development
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_RAW_BUCKET=law-raw

# NVIDIA hosted NIM 생성과 임베딩. NVIDIA_API_KEY는 서버 전용입니다.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_DIMENSIONS=512
EMBEDDING_TIMEOUT_SECONDS=30

# 익명 사용량 HMAC. 충분히 긴 무작위 문자열을 사용하세요.
RATE_LIMIT_SECRET=development-only-secret
# 로그인 계정 일일 quota는 로직을 보존하되 현재 기본 OFF입니다.
ACCOUNT_QUOTA_ENABLED=false
AUTHENTICATED_AI_DAILY_LIMIT=10
AUTHENTICATED_SEARCH_DAILY_LIMIT=100

# 배포 URL
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
REQUEST_TIMEOUT_SECONDS=30
