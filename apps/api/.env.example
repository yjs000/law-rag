# Local: copy to .env.local. Vercel: register in Project Settings instead.
APP_NAME=에너지 법령 RAG
ENVIRONMENT=development

# Supabase PostgreSQL via Supavisor.
# Vercel runtime: Supavisor transaction mode (port 6543).
DATABASE_URL=
# Alembic migrations: Supavisor session mode (port 5432) on IPv4-only hosts.
DIRECT_URL=

# Server-side Supabase Auth/Storage access. SUPABASE_SECRET_KEY must start with
# sb_secret_ and must never be exposed through NEXT_PUBLIC_* or browser code.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_RAW_BUCKET=law-raw

# Local mock fallback only. Do not configure this on Vercel production.
COLLECTOR_STATE_DIR=.collector-state

# Answer generation. NVIDIA_API_KEY is server-only and must be registered in Vercel.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_ANSWER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# 0028 tier 2 라우팅 분류기. 답변 생성과 분리된 별도 호출(NVIDIA_API_KEY 재사용).
NVIDIA_ROUTE_CLASSIFIER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Global database-backed limit for concurrent V2 provider phases. Keep this at
# the provider-approved capacity; Production currently uses the safe default.
V2_PROVIDER_SLOTS=3
ANSWER_MAX_OUTPUT_TOKENS=4096
ANSWER_GENERATION_MAX_ATTEMPTS=3
EMBEDDING_DIMENSIONS=512
# 배치/오프라인 스크립트(32개 passage를 한 번에 임베딩하는 corpus backfill 등)가 쓰는
# 일반 임베딩 HTTP 타임아웃. 라이브 질문 요청 예산 안에서는 아래
# QUESTION_EMBEDDING_TIMEOUT_SECONDS를 대신 쓴다.
EMBEDDING_TIMEOUT_SECONDS=30

# /v1/questions: 60초 Vercel hard limit보다 8초 먼저 끝내고 응답 마무리에 3초를 남긴다.
QUESTION_REQUEST_TIMEOUT_SECONDS=52
RESPONSE_RESERVE_SECONDS=3
ROUTE_CLASSIFIER_TIMEOUT_SECONDS=8
QUESTION_EMBEDDING_TIMEOUT_SECONDS=5
RETRIEVAL_TIMEOUT_SECONDS=8
ANSWER_TIMEOUT_SECONDS=40

AI_MODE=auto

# HMAC key for privacy-preserving anonymous rate-limit identifiers.
# Replace this with a different random value in Preview and Production.
RATE_LIMIT_SECRET=development-only-secret
# Login-account daily quota is toggleable but currently disabled by default.
ACCOUNT_QUOTA_ENABLED=false
AUTHENTICATED_AI_DAILY_LIMIT=10
AUTHENTICATED_SEARCH_DAILY_LIMIT=100

# Comma-separated exact web origins only; never use a *.vercel.app wildcard.
# e.g. WEB_ORIGIN=https://prod.example.com,https://preview-abc123.vercel.app
WEB_ORIGIN=http://localhost:3000

# Supabase Auth HTTP 요청용이며 /v1/questions 전체 예산과 별개다.
REQUEST_TIMEOUT_SECONDS=30
